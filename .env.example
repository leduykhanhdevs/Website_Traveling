# Traveling Platform - Environment Configuration Template
# Sao chep tep nay thanh .env.local va dien cac gia tri thich hop khi cau hinh dich vu backend.

# Dich vu Email (Early Access / Waitlist Notification)
VITE_EMAIL_SERVICE_API_KEY=[TEN_BIEN_MOI_TRUONG]
VITE_EMAIL_SERVICE_ENDPOINT=https://api.resend.com/emails

# Dich vu Xac thuc nguoi dung (Clerk Auth)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Ban do va Du lieu Thoi tiet
VITE_WEATHER_API_KEY=placeholder_weather_key